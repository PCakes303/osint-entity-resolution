{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/osint/resolution-candidate/1.0.0",
  "title": "Entity Resolution Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "left_entity_id",
    "right_entity_id",
    "score",
    "score_kind",
    "reason_codes",
    "evidence_refs",
    "uncertainty",
    "review_status",
    "created_at"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^cand:[a-f0-9]{64}$"
    },
    "left_entity_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "right_entity_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "score_kind": {
      "const": "heuristic_similarity_not_probability"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "exact_public_identifier",
          "normalized_name_similarity",
          "shared_alias"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 128
      }
    },
    "uncertainty": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "review_status": {
      "const": "review_required"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
